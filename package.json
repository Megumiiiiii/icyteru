{
  "name": "icyteru",
  "productName": "Icyteru",
  "version": "0.0.90",
  "description": "A simple desktop and Android client for an existing Hermes Agent gateway.",
  "author": "Megumiiiiii",
  "license": "MIT",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.node.json && vite build",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.renderer.json --noEmit",
    "test": "tsc -p tsconfig.node.json && node --test dist/shared/protocol.test.js dist/shared/client.test.js dist/shared/client.api.test.js dist/shared/socket.test.js dist/shared/group-order.test.js dist/shared/markdown-inline.test.js dist/shared/chat-activity.test.js dist/shared/model-choice.test.js",
    "version:check": "node scripts/version.mjs check",
    "version:sync": "node scripts/version.mjs sync",
    "version:set": "node scripts/version.mjs set",
    "dev": "tauri dev",
    "dev:web": "vite",
    "start": "tauri dev",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "tauri:build:debug": "tauri build --debug --no-bundle",
    "build:web": "vite build",
    "cap:sync": "npm run build:web && cap sync android",
    "android:apk": "npm run cap:sync && cd android && ./gradlew assembleRelease",
    "dist": "tauri build"
  },
  "dependencies": {
    "ws": "^8.18.2"
  },
  "devDependencies": {
    "@capacitor/android": "^7.6.10",
    "@capacitor/app": "^7.1.2",
    "@capacitor/cli": "^7.6.10",
    "@capacitor/core": "^7.6.10",
    "@capacitor/keyboard": "^7.0.6",
    "@capacitor/local-notifications": "^7.0.7",
    "@capacitor/status-bar": "^7.0.6",
    "@fontsource/inter": "^5.3.0",
    "@tauri-apps/api": "^2.12.5",
    "@tauri-apps/cli": "^2.12.6",
    "@tauri-apps/plugin-dialog": "^2.4.2",
    "@tauri-apps/plugin-notification": "^2.3.3",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.14.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.3",
    "vite": "^6.2.0",
    "wait-on": "^8.0.2"
  }
}
